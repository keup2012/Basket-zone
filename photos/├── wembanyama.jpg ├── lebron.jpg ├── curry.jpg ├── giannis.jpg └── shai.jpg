                </div>

            </div>

        </div>

        <!-- GIANNIS -->

        <div
            class="player-card"
            data-name="giannis antetokounmpo"
        >

            <div class="player-photo">

                <img
                    src="photos/giannis.jpg"
                    alt="Giannis Antetokounmpo"
                    onerror="this.style.display='none'; this.parentElement.innerHTML='🏀';"
                >

            </div>

            <h3>
                Giannis Antetokounmpo
            </h3>

            <p class="team-name">
                Miami Heat
            </p>

            <div class="stats">

                <div class="stat">
                    <strong>—</strong>
                    <span>PTS</span>
                </div>

                <div class="stat">
                    <strong>—</strong>
                    <span>REB</span>
                </div>

                <div class="stat">
                    <strong>—</strong>
                    <span>AST</span>
                </div>

            </div>

        </div>

        <!-- SHAI -->

        <div
            class="player-card"
            data-name="shai gilgeous alexander"
        >

            <div class="player-photo">

                <img
                    src="photos/shai.jpg"
                    alt="Shai Gilgeous-Alexander"
                    onerror="this.style.display='none'; this.parentElement.innerHTML='🏀';"
                >

            </div>

            <h3>
                Shai Gilgeous-Alexander
            </h3>

            <p class="team-name">
                Oklahoma City Thunder
            </p>

            <div class="stats">

                <div class="stat">
                    <strong>—</strong>
                    <span>PTS</span>
                </div>

                <div class="stat">
                    <strong>—</strong>
                    <span>REB</span>
                </div>

                <div class="stat">
                    <strong>—</strong>
