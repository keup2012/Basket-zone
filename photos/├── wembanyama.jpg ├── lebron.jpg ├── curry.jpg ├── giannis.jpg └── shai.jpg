    <div class="search-container">

        <input
            id="searchInput"
            type="text"
            placeholder="Rechercher un joueur..."
        >

        <button id="searchButton">
            🔎 Rechercher
        </button>

    </div>

</header>

<!-- MENU -->

<nav>

