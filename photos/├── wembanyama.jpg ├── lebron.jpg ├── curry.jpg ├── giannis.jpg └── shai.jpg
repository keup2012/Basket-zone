
<!DOCTYPE html>

<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

```
<title>Basket Zone 🏀</title>

<style>

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: Arial, sans-serif;
        background: #f2f2f2;
        color: #222;
    }

    /* =========================
       HEADER
    ========================= */

    header {
        background: #111;
        color: white;
        text-align: center;
        padding: 30px 20px;
    }

    header h1 {
        font-size: 42px;
        margin-bottom: 10px;
    }

    header p {
        color: #ccc;
        margin-bottom: 25px;
    }

    .search-container {
        max-width: 700px;
        margin: auto;
        display: flex;
        gap: 10px;
    }

    #searchInput {
        flex: 1;
        padding: 14px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        outline: none;
    }

    #searchButton {
        padding: 14px 20px;
        border: none;
        border-radius: 8px;
        background: #f58220;
        color: white;
        font-weight: bold;
        cursor: pointer;
    }

    #searchButton:hover {
        background: #d9680c;
    }

    /* =========================
       MENU
    ========================= */

    nav {
        background: #f58220;
        display: flex;
        justify-content: center;
        gap: 30px;
        padding: 15px;
        flex-wrap: wrap;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    nav a {
        color: white;
        text-decoration: none;
        font-weight: bold;
    }

    nav a:hover {
        text-decoration: underline;
    }

    /* =========================
       TITRES
    ========================= */

    .section-title {
        text-align: center;
        margin: 45px 0 25px;
        font-size: 30px;
    }

    /* =========================
       ACTUALITÉS
    ========================= */

    .news-status {
        text-align: center;
        color: #777;
        margin-bottom: 25px;
    }

    .news-container {
        width: 90%;
        max-width: 1200px;
        margin: auto;
        display: grid;
        grid-template-columns:
            repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        padding-bottom: 40px;
    }

    .news-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow:
            0 5px 15px rgba(0,0,0,0.12);
        transition:
            transform 0.2s,
            box-shadow 0.2s;
    }

    .news-card:hover {
        transform: translateY(-6px);
        box-shadow:
            0 10px 25px rgba(0,0,0,0.18);
    }

    .news-image {
        background: #111;
        color: white;
        height: 150px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 55px;
    }

    .news-content {
        padding: 22px;
    }

    .news-category {
        display: inline-block;
        background: #f58220;
        color: white;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        margin-bottom: 12px;
    }

    .news-card h3 {
        font-size: 21px;
        line-height: 1.3;
        margin-bottom: 12px;
    }

    .news-card p {
        color: #555;
        line-height: 1.5;
        margin-bottom: 15px;
    }

    .news-date {
        font-size: 13px;
        color: #888;
        margin-bottom: 10px;
    }

    .news-source {
        font-size: 13px;
        color: #f58220;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .news-link {
        display: inline-block;
        background: #111;
        color: white;
        padding: 10px 15px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
    }

    .news-link:hover {
        background: #f58220;
    }

    /* =========================
       MATCHS
    ========================= */

    .matches-container {
        width: 90%;
        max-width: 1100px;
        margin: auto;
        display: grid;
        grid-template-columns:
            repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
    }

    .match-card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        text-align: center;
        box-shadow:
            0 5px 15px rgba(0,0,0,0.12);
    }

    .match-card h3 {
        color: #f58220;
        margin-bottom: 20px;
    }

    .teams {
        display: flex;
        justify-content: space-around;
        align-items: center;
        gap: 15px;
    }

    .team {
        flex: 1;
        font-weight: bold;
    }

    .team-icon {
        display: block;
        font-size: 40px;
        margin-bottom: 8px;
    }

    .vs {
        color: #777;
        font-weight: bold;
    }

    .match-date {
        margin-top: 20px;
        background: #f5f5f5;
        padding: 10px;
        border-radius: 8px;
        color: #555;
    }

    .no-game {
        width: 90%;
        max-width: 800px;
        margin: auto;
        background: white;
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        box-shadow:
            0 5px 15px rgba(0,0,0,0.10);
    }

    /* =========================
       JOUEURS
    ========================= */

    .players-container {
        width: 90%;
        max-width: 1200px;
        margin: auto;
        display: grid;
        grid-template-columns:
            repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
        padding-bottom: 40px;
    }

    .player-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow:
            0 5px 15px rgba(0,0,0,0.12);
        transition: transform 0.2s;
    }

    .player-card:hover {
        transform: translateY(-5px);
    }

    .player-photo {
        width: 130px;
        height: 130px;
        margin: auto;
        border-radius: 50%;
        background: #eee;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 45px;
    }

    .player-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .player-card h3 {
        text-align: center;
        margin-top: 15px;
    }

    .team-name {
        text-align: center;
        color: #777;
        margin: 8px 0 20px;
    }

    /* =========================
       STATS
    ========================= */

    .stats {
        display: grid;
        grid-template-columns:
            repeat(3, 1fr);
        gap: 8px;
    }

    .stat {
        background: #f5f5f5;
        padding: 10px 5px;
        text-align: center;
        border-radius: 8px;
    }

    .stat strong {
        display: block;
        color: #f58220;
        font-size: 20px;
    }

    .stat span {
        font-size: 12px;
        color: #666;
    }

    /* =========================
       CLASSEMENT
    ========================= */

    .ranking {
        width: 90%;
        max-width: 800px;
        margin: auto;
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow:
            0 5px 15px rgba(0,0,0,0.10);
    }

    .ranking p {
        padding: 12px;
        border-bottom: 1px solid #eee;
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
        margin-top: 50px;
        background: #111;
        color: white;
        text-align: center;
        padding: 25px;
    }

    footer span {
        color: #f58220;
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 600px) {

        header h1 {
            font-size: 30px;
        }

        .search-container {
            flex-direction: column;
        }

        #searchInput {
            width: 100%;
        }

        #searchButton {
            width: 100%;
        }

        .teams {
            flex-direction: column;
        }

        .vs {
            margin: 5px 0;
        }

    }

</style>
```

</head>

<body>

```
<!-- HEADER -->

<header id="accueil">

