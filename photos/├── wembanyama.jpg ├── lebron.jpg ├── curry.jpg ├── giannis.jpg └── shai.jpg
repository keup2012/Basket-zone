                </div>

            </div>

        </div>

    </div>

</section>

<!-- CLASSEMENT -->

<section id="classement">

    <h2 class="section-title">
        🏆 Classement NBA
    </h2>

    <div class="ranking">

        <p>
            Le classement 2026-2027 sera disponible
            au début de la saison régulière.
        </p>

    </div>

</section>

<!-- FOOTER -->

<footer>

    <p>
        🏀
        <span>Basket Zone</span>
        — Le basketball au quotidien
    </p>

    <p style="margin-top:10px;color:#aaa;">
        📰 Actualités mises à jour automatiquement
    </p>

</footer>

<!-- JAVASCRIPT -->

<script>

    /* =========================
       RECHERCHE JOUEURS
    ========================= */

    const searchInput =
        document.getElementById("searchInput");

    const searchButton =
        document.getElementById("searchButton");

    const playerCards =
        document.querySelectorAll(".player-card");

    function searchPlayers() {

        const text =
            searchInput.value
                .toLowerCase()
                .trim();

        playerCards.forEach(
            function(card) {

                const name =
                    card.dataset.name
                        .toLowerCase();

                if (
                    name.includes(text)
                    ||
                    text === ""
                ) {

                    card.style.display = "block";

                } else {

                    card.style.display = "none";

                }

            }
        );

    }

    searchButton.addEventListener(
        "click",
        searchPlayers
    );

    searchInput.addEventListener(
        "input",
        searchPlayers
    );

    searchInput.addEventListener(
        "keydown",
        function(event) {

            if (event.key === "Enter") {
                searchPlayers();
            }

        }
    );

    /* =========================
       ACTUALITÉS AUTOMATIQUES
    ========================= */

    const newsContainer =
        document.getElementById("newsContainer");

    const newsStatus =
        document.getElementById("newsStatus");

    function escapeHTML(text) {

        const div =
            document.createElement("div");

        div.textContent = text || "";

        return div.innerHTML;
    }

    function formatDate(dateString) {

        if (!dateString) {
            return "Date inconnue";
        }

        const date =
            new Date(dateString);

        if (isNaN(date.getTime())) {
            return dateString;
        }

        return date.toLocaleDateString(
            "fr-FR",
            {
                day: "2-digit",
                month: "2-digit",
                year: "numeric"
            }
        );

    }

    async function loadNews() {

        try {

            newsStatus.textContent =
                "🔄 Chargement des actualités...";

            const response =
                await fetch(
                    "news.json?t=" + Date.now()
                );

            if (!response.ok) {

                throw new Error(
                    "news.json introuvable"
                );

            }

            const data =
                await response.json();

            newsContainer.innerHTML = "";

            if (
                !data.articles
                ||
                data.articles.length === 0
            ) {

                newsStatus.textContent =
                    "📰 Les actualités seront disponibles après la première mise à jour.";

                return;

            }

            newsStatus.textContent =
                "🟢 Actualités NBA mises à jour automatiquement";

            data.articles.forEach(
                function(article) {

                    const card =
                        document.createElement("article");

                    card.className =
                        "news-card";

                    card.innerHTML = `

                        <div class="news-image">
                            🏀
                        </div>

                        <div class="news-content">

                            <span class="news-category">
                                NBA
                            </span>

                            <h3>
                                ${escapeHTML(
                                    article.title
                                )}
                            </h3>

                            <p>
                                ${escapeHTML(
                                    article.description
                                )}
                            </p>

                            <div class="news-date">
                                📅
                                ${formatDate(
                                    article.date
                                )}
                            </div>

                            <div class="news-source">
                                Source :
                                ${escapeHTML(
                                    article.source
                                )}
                            </div>

                            <a
                                class="news-link"
                                href="${article.link}"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Lire l'article →
                            </a>

                        </div>

                    `;

                    newsContainer.appendChild(card);

                }
            );

        } catch (error) {

            console.error(
                "Erreur actualités :",
                error
            );

            newsStatus.textContent =
                "❌ Impossible de charger les actualités pour le moment.";

        }

    }

    loadNews();

    setInterval(
        loadNews,
        5 * 60 * 1000
    );

</script>
```

</body>

</html>
